NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Clerk (frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Worker GPU (Ubuntu LAN) — obligatoire si Next tourne sur une autre machine
WORKER_TRANSLATE_URL=http://192.168.100.11:8788
WORKER_UPLOAD_URL=http://192.168.100.11:8787

# Also set on Convex deployment (auth.config.ts):
# CLERK_JWT_ISSUER_DOMAIN=https://YOUR-INSTANCE.clerk.accounts.dev
# + JWT template named "convex" in Clerk Dashboard (aud = convex)
