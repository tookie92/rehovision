CONVEX_URL=http://127.0.0.1:3210
WORKER_TOKEN=change-me
WORKER_STALE_MINUTES=15
MUSIC_ENGINE=fake
VOICE_ENGINE=auto
WHISPER_MODEL=Systran/faster-whisper-base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
# MT doublage (NLLB — remplace Ollama sur ce chemin)
NLLB_MODEL=facebook/nllb-200-distilled-600M
NLLB_DEVICE=cuda:0
TRANSLATE_HOST=127.0.0.1
TRANSLATE_PORT=8788
NLLB_TIMEOUT_S=300
# HyperFrames polish (Node >= 22)
# HYPERFRAMES_NODE=/path/to/node
# HYPERFRAMES_TIMEOUT_S=600
# ACESTEP_MODEL_PATH=
# ACESTEP_INFERENCE_STEPS=8
