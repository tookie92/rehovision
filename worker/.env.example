# URL HTTP Actions Convex (NEXT_PUBLIC_CONVEX_SITE_URL)
# Ex: https://zany-octopus-165.eu-west-1.convex.site
CONVEX_SITE_URL=

# Même valeur que WORKER_SECRET_KEY côté Convex / .env.local
WORKER_SECRET_KEY=

# Polling
POLL_INTERVAL_SECONDS=3

# Ollama local (script narratif)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Piper TTS (après scripts/download_piper_fr.sh)
PIPER_BIN=./bin/piper
PIPER_MODEL_PATH=./models/piper/fr_FR-siwis-medium.onnx

# Diffusers / SDXL Turbo
SD_MODEL_ID=stabilityai/sdxl-turbo
SD_WIDTH=576
SD_HEIGHT=1024
SD_STEPS=4
SD_GUIDANCE=0
