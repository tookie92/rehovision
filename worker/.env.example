# URL HTTP Actions Convex (NEXT_PUBLIC_CONVEX_SITE_URL)
# Ex: https://zany-octopus-165.eu-west-1.convex.site
CONVEX_SITE_URL=

# Même valeur que WORKER_SECRET_KEY côté Convex / .env.local
WORKER_SECRET_KEY=

# Polling
POLL_INTERVAL_SECONDS=3

# Ollama local (script narratif)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# TTS : omnivoice (défaut) | piper
TTS_ENGINE=omnivoice
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
OMNIVOICE_INSTRUCT=male, low pitch
OMNIVOICE_NUM_STEP=32
OMNIVOICE_SPEED=1.0
# Clone (optionnel) — 3–10s de ref audio
# OMNIVOICE_REF_AUDIO=./models/voices/studio_ref.wav
# OMNIVOICE_REF_TEXT=Transcription exacte de la ref
# Ou prompt pré-encodé :
# OMNIVOICE_VOICE_PROMPT=./models/voices/studio.pt

# Piper (fallback si TTS_ENGINE=piper)
PIPER_BIN=./bin/piper
PIPER_MODEL_PATH=./models/piper/fr_FR-siwis-medium.onnx

# Diffusers / Flux Schnell (Apache 2.0, gratuit en local)
# Accepter la licence HF une fois : https://huggingface.co/black-forest-labs/FLUX.1-schnell
# Si le repo est gated : HF_TOKEN=hf_xxx
SD_MODEL_ID=black-forest-labs/FLUX.1-schnell
SD_WIDTH=576
SD_HEIGHT=1024
SD_STEPS=4
SD_GUIDANCE=0
SD_MAX_SEQUENCE_LENGTH=256
# 1 = cpu offload (recommandé RTX 3060 12GB) ; 0 = tout en VRAM
SD_CPU_OFFLOAD=1
# Optionnel : seed fixe pour cohérence inter-scènes
# SD_SEED=42
# Force de l'image de référence en img2img (0.5–0.8 ; plus haut = plus proche de la ref)
SD_REF_STRENGTH=0.68
# HF_TOKEN=

# ChatCut — Whisper (faster-whisper) + ffmpeg
WHISPER_MODEL=base
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# Captions virales (ASS karaoke)
CAPTION_WORDS_PER_CUE=4
CAPTION_KARAOKE=1
CAPTION_FONT_SIZE=68
CAPTION_MARGIN_V=260
# CAPTION_FONT=Arial Black

# Reframe 9:16 — smart (visage) | center | letterbox
REFRAME_MODE=smart
REFRAME_SAMPLES=8
# opencv-python-headless requis pour smart

# AI B-roll (Flux stills overlay) — 0 pour désactiver
BROLL_ENABLED=1
BROLL_MAX=2
BROLL_DURATION=1.8
BROLL_WIDTH=576
BROLL_HEIGHT=1024

# Captions style défaut (viral|bold_green|yellow_pop|minimal)
CAPTION_STYLE=viral
# Layout défaut worker si payload absent (smart|fill|fit|split)
# REFRAME_MODE=smart

