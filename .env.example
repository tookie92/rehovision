# Clerk (généré via `npx clerk init` ou Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex Cloud (optionnel — désactivé si self-hosted)
# CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://convex-clips.rehovision.com
NEXT_PUBLIC_CONVEX_SITE_URL=https://convex-clips-site.rehovision.com

# Convex self-hosted (voir docker/convex-self-hosted/)
CONVEX_SELF_HOSTED_URL=https://convex-clips.rehovision.com
CONVEX_SELF_HOSTED_ADMIN_KEY=
# Deploy CLI (local docker :3220) — évite 404 Cloudflare si ingress pas à jour
CONVEX_SELF_HOSTED_DEPLOY_URL=http://127.0.0.1:3220

# Issuer Clerk pour Convex = Frontend API URL
# Ex: https://verb-noun-00.clerk.accounts.dev
# Self-hosted : `npm run convex:env:clerk` échoue souvent (404) —
# l’issuer est dans convex/auth.config.ts + JWT template "convex" :
#   npm run clerk:ensure-convex
#   npm run convex:deploy:self-hosted
CLERK_FRONTEND_API_URL=
# Alias legacy (même valeur)
# CLERK_JWT_ISSUER_DOMAIN=

# Clé secrète partagée avec le worker Python (Ollama / SD / TTS / ffmpeg)
WORKER_SECRET_KEY=

# Upload gros vlogs → disque worker (évite timeout Convex 2 min)
# 1) Sur Ubuntu worker/.env : UPLOAD_HTTP_PORT=8787 + WORKER_PUBLIC_URL=http://IP:8787
# 2) Ici :
NEXT_PUBLIC_WORKER_UPLOAD=1
# URL LAN du worker (Next proxy + upload direct navigateur → :8787)
WORKER_UPLOAD_URL=http://IP_UBUNTU:8787
# ufw allow 8787 — navigateur Windows doit joindre cette IP (sinon fallback chunks lents)
