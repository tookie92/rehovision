# --- Convex self-hosted (CLI + deploy) ---
# Doc: https://docs.convex.dev/self-hosting
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# Quotes obligatoires : la clé contient le caractère |
CONVEX_SELF_HOSTED_ADMIN_KEY='convex-self-hosted|…'

# Ports Docker (optionnel, défauts officiels)
PORT=3210
SITE_PROXY_PORT=3211
DASHBOARD_PORT=6791

# --- Web (Next.js dans web/) ---
# URL du backend Convex vue par le navigateur
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# --- Worker GPU ---
CONVEX_URL=http://127.0.0.1:3210
# Même valeur que la variable d'environnement Convex WORKER_TOKEN
WORKER_TOKEN=
# Minutes avant reclaim des jobs "running" orphelins
WORKER_STALE_MINUTES=15
# fake | acestep
MUSIC_ENGINE=fake
