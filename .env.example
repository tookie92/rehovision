# Clerk (généré via `npx clerk init` ou Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex (généré via `npx convex deployment create --select`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Issuer Clerk pour auth.config.ts Convex (Frontend API URL)
# Ex: https://verb-noun-00.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Clé secrète partagée avec le worker Python (Ollama / SD / TTS / ffmpeg)
WORKER_SECRET_KEY=
